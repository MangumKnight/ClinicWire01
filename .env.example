# Database
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/clinicwire

# Twilio (Required for production)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ElevenLabs (Required for production)
ELEVENLABS_API_KEY=your_api_key

# Authentication
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# Email (for magic links)
EMAIL_FROM=noreply@clinicwire.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Settings
APP_ENV=development
FRONTEND_URL=http://localhost:8002
PORT=8001
SIMULATE=true  # Set to false for real calls

# Feature Flags
ENABLE_WATCHDOG=false
MAX_HOLD_SECONDS=1200
ENABLE_OUTCOME_V2=false

# Optional
MCP_BASE_URL=http://localhost:8001
SMS_BRAND=[ClinicWire]
SMS_MAX_PER_HOUR=3
DEFAULT_AREA_CODE=919